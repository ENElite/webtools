{
  "name": "webtools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.24.0 <13"
  },
  "scripts": {
    "dev:webpaper": "pnpm --filter @webtools/webpaper dev",
    "build:webpaper": "pnpm --filter @webtools/webpaper build",
    "preview:webpaper": "pnpm --filter @webtools/webpaper start",
    "dev:docs": "pnpm --filter @webtools/webdocs dev",
    "build:docs": "pnpm --filter @webtools/webdocs build",
    "preview:docs": "pnpm --filter @webtools/webdocs preview",
    "dev:webtools": "pnpm --filter @webtools/webtools dev",
    "build:webtools": "pnpm --filter @webtools/webtools build",
    "start:webtools": "pnpm --filter @webtools/webtools start",
    "build": "turbo run build",
    "test": "vitest run",
    "test:packages": "turbo run test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@iconify-json/octicon": "^1.2.22",
    "@iconify/tailwind4": "^1.2.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "24.13.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/ui": "^4.1.4",
    "@next/eslint-plugin-next": "16.2.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.68.0",
    "turbo": "2.10.12",
    "vite": "^6.4.2",
    "vite-plugin-cp": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
