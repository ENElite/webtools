{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "antd": [
                "./node_modules/antd/es/index"
            ]
        },
        "types": [
            "vite/client"
        ],
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "moduleDetection": "force"
    },
    "include": [
        "src/**/*"
    ]
}