{
  "name": "@webtools/webwidget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.ts"
    },
    "./engine": {
      "default": "./src/engine/index.ts"
    },
    "./engine/model": {
      "default": "./src/engine/model/index.ts"
    },
    "./engine/editor": {
      "default": "./src/engine/editor/index.ts"
    },
    "./editors": {
      "default": "./src/editors/index.ts"
    },
    "./runtime": {
      "default": "./src/runtime/index.ts"
    },
    "./styles.css": "./styles.css",
    "./components/editor": {
      "default": "./src/components/editor/index.ts"
    },
    "./components/settings": {
      "default": "./src/components/settings/index.ts"
    },
    "./store": {
      "types": "./store.d.ts",
      "default": "./store.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iconify/react": "^4.1.0",
    "@reactuses/core": "^6.3.1",
    "antd": "^6.3.5",
    "framer-motion": "^12.40.0",
    "immer": "^11.1.8",
    "l2d": "^2.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-moveable": "^0.56.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "4.1.4",
    "babel-plugin-import": "^1.13.8",
    "vite": "^6.4.2",
    "vitest": "^4.1.4"
  }
}
